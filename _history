nyImage.setPixel(9, 7, 15)\nbunnyImage.setPixel(7, 10, 2)\nbunnyImage.setPixel(8, 10, 2)\nbunnyImage.setPixel(4, 12, 1)\nbunnyImage.setPixel(11, 12, 1)\n\nlet player = sprites.create(bunnyImage, SpriteKind.Player)\nplayer.setPosition(18, 96)\nplayer.setFlag(SpriteFlag.StayInScreen, true)\n\ncontroller.moveSprite(player, 70, 0)\n\n// PLATAFORMAS\nlet platforms: Sprite[] = []\n\nfunction makePlatform(x: number, y: number, width: number, color: number) {\n    let picture = image.create(width, 8)\n    picture.fill(color)\n    for (let i = 0; i < width; i++) {\n        picture.setPixel(i, 0, 1)\n    }\n    let platform = sprites.create(picture, SpriteKind.Platform)\n    platform.setPosition(x, y)\n    platforms.push(platform)\n}\n\nmakePlatform(18, 108, 34, 6)\nmakePlatform(53, 88, 34, 7)\nmakePlatform(88, 68, 34, 5)\nmakePlatform(123, 48, 34, 8)\nmakePlatform(148, 28, 28, 6)\n\n// BLOQUES PELIGROSOS\nfunction makeHazard(x: number, y: number) {\n    let picture = image.create(12, 12)\n    picture.fill(2)\n    for (let i = 0; i < 12; i++) {\n        picture.setPixel(i, 0, 4)\n    }\n    let hazard = sprites.create(picture, SpriteKind.Hazard)\n    hazard.setPosition(x, y)\n}\n\nmakeHazard(63, 76)\nmakeHazard(132, 36)\n\n// META\nlet goalImage = image.create(12, 16)\nfor (let y = 1; y < 16; y++) {\n    goalImage.setPixel(2, y, 15)\n}\nfor (let x = 3; x < 11; x++) {\n    goalImage.setPixel(x, 2, 4)\n    goalImage.setPixel(x, 3, 4)\n}\nlet goal = sprites.create(goalImage, SpriteKind.Goal)\ngoal.setPosition(148, 12)\n\n// GRAVEDAD Y SALTO\nlet verticalSpeed = 0\nlet grounded = false\nlet previousBottom = player.bottom\n\ncontroller.A.onEvent(ControllerButtonEvent.Pressed, function () {\n    if (grounded) {\n        verticalSpeed = -8\n        grounded = false\n    }\n})\n\n// CONTROL DE VIDAS\nlet invulnerable = false\nlet cooldown = 0\n\nfunction takeDamage() {\n    if (!invulnerable) {\n        invulnerable = true\n        cooldown = 50\n        info.changeLifeBy(-1)\n        player.setPosition(18, 96)\n        verticalSpeed = 0\n        grounded = false\n    }\n}\n\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Hazard, function () {\n    takeDamage()\n})\n\n// FÍSICA Y PLATAFORMAS\ngame.onUpdateInterval(20, function () {\n    previousBottom = player.bottom\n\n    if (!grounded) {\n        verticalSpeed += 0.55\n    }\n\n    player.y += verticalSpeed\n    grounded = false\n\n    for (let platform of platforms) {\n        if (\n            verticalSpeed >= 0 &&\n            previousBottom <= platform.top &&\n            player.bottom >= platform.top &&\n            player.right > platform.left &&\n            player.left < platform.right\n        ) {\n            player.y = platform.top - player.height / 2\n            verticalSpeed = 0\n            grounded = true\n        }\n    }\n\n    if (player.y > 130) {\n        takeDamage()\n    }\n\n    if (cooldown > 0) {\n        cooldown--\n        if (cooldown == 0) {\n            invulnerable = false\n        }\n    }\n})\n\n// GANAR\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Goal, function () {\n    game.over(true)\n})\n\n// PERDER\ninfo.onLifeZero(function () {\n    game.over(false)\n})","README.md":" ","assets.json":"","tilemap.g.jres":"{\n    \"transparency16\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName\": \"baseTransparency16\"\n    },\n    \"tile1\": {\n        \"data\": \"hwQQABAAAABFJEJCRVRFREQiIiJEQlVVREIiIkRCRFVFIiJEJCJCVUVERFQkQkJFVERUVSQiQkVUVVVVRCJURURERFVFQlREJCJCRFVEVCQiIkIkVFVVJCJERCJCVUUiIlREQkJVJCREVUUiQkVCQkRVRSJERSIkRFVEIlRFIkJURSRCVFVERA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName\": \"hazardLava1\"\n    },\n    \"tile2\": {\n        \"da